{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "summary", "dimensions"],
  "properties": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "documentId", "revision", "title"],
      "properties": {
        "projectId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "documentId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "revision": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "面向 GDD 提交者的 2-3 句自然语言总结，具体概括主要优点、主要缺点与下一步改进方向；不得提及评分流程、AI/人工权重、维度排名或证据缺口数量。"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["experienceValue", "gameplaySystems", "contentPresentation"],
      "properties": {
        "experienceValue": { "$ref": "#/$defs/dimension30" },
        "gameplaySystems": { "$ref": "#/$defs/dimension40" },
        "contentPresentation": { "$ref": "#/$defs/dimension30" }
      }
    },
    "additionalFindings": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "evidence"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 500 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "dimension30": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "observations", "rationale", "evidenceGaps"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 30 },
        "observations": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/observation" } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceGaps": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "dimension40": {
      "type": "object",
      "additionalProperties": false,
      "required": ["score", "observations", "rationale", "evidenceGaps"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 40 },
        "observations": { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/observation" } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "evidenceGaps": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence", "description"],
      "properties": {
        "evidence": { "type": "string", "minLength": 1, "maxLength": 300 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
